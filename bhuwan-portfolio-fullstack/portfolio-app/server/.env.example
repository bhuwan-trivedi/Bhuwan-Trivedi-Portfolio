# Copy this file to ".env" (same folder) and fill in your real values.
# The server reads .env automatically — no need to set these in the terminal each time.

# Password to log into /admin.html — change this to something only you know.
ADMIN_TOKEN=changeme123

# --- Email notifications for the contact form ---
# Leave EMAIL_USER / EMAIL_PASS blank to disable emails (messages will still
# be saved and visible in the admin panel either way).
#
# Gmail will NOT accept your normal account password here — you must create
# an "App Password" instead:
#   1. Go to https://myaccount.google.com/security
#   2. Turn on 2-Step Verification (required before app passwords are available)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create a new app password (name it anything, e.g. "portfolio site")
#   5. Google shows you a 16-character password like "abcd efgh ijkl mnop"
#      — paste that below as EMAIL_PASS (spaces don't matter)

EMAIL_USER=bhuwantrivedi20@gmail.com
EMAIL_PASS=@kanishka2208
EMAIL_TO=bhuwantrivedi20@gmail.com

PORT=4000
